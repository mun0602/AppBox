NODE_ENV=production
APPBOX_API_PORT=39110
APPBOX_API_HOST=127.0.0.1
APPBOX_ALLOWED_ORIGINS=https://3601.help
PUBLIC_API_BASE_URL=https://3601.help
PUBLIC_LINK_BASE_URL=https://3601.help

APPBOX_DATA_FILE=/var/lib/appbox/appbox-store.json
APPBOX_ASSET_DIR=/var/lib/appbox/assets
# Set to true to return an encrypted, valid catalog with an empty category list
# while preserving all applications and taxonomy in the data store.
APPBOX_CATALOG_EMPTY=false

APPBOX_ADMIN_USERNAME=admin
APPBOX_ADMIN_PASSWORD_HASH=replace-with-scrypt-hash
APPBOX_ADMIN_SESSION_SECRET=replace-with-random-base64
APPBOX_CREDENTIAL_AES_KEY=replace-with-random-base64

# This protocol key is embedded in the current iOS client and is not an admin secret.
APPBOX_CLIENT_AES_KEY=6btlrID18OytwUZ0s41atap+4WxlXr1xpebjrE04hnY=
APPBOX_CLIENT_AES_KID=v1
APPBOX_CLIENT_ENCRYPTION_REQUIRED=true

# Leave empty to use the shared documented SHA-256 fallback material, or set
# the same base64/hex values when building NIVMHost.
APPBOX_ASSET_AES_KEY=
APPBOX_ASSET_AES_IV=
APPBOX_INTERNAL_UNLOCK_ENABLED=true
APPBOX_INTERNAL_UNLOCK_SECRET=replace-with-a-separate-random-secret
# Optional reusable verification code. Leave empty to allow one-time codes only.
APPBOX_INTERNAL_UNLOCK_FIXED_CODE=
