<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>临时邮箱</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TempMail</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>TempMailCatalogBaseURL</key>
	<string>$(TEMPMAIL_CATALOG_BASE_URL)</string>
	<key>TempMailClientAESKey</key>
	<string>$(TEMPMAIL_CLIENT_AES_KEY)</string>
	<key>TempMailAssetAESKey</key>
	<string>$(TEMPMAIL_ASSET_AES_KEY)</string>
	<key>TempMailAssetAESIV</key>
	<string>$(TEMPMAIL_ASSET_AES_IV)</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- TempMail deep-link scheme used to select and restore an application surface. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>tempmail.sandbox.callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tempmail</string>
			</array>
		</dict>
	</array>

    <!-- 仅保留已链接运行组件可能调用的系统隐私能力。所有权限均由用户操作触发。 -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>临时邮箱仅在您主动选择图片或视频时访问相册。</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>临时邮箱仅在您主动保存图片或视频时写入相册。</string>
    
    <key>NSCameraUsageDescription</key>
    <string>临时邮箱仅在您主动扫描二维码或拍摄内容时使用相机。</string>
    
    <key>NSMicrophoneUsageDescription</key>
    <string>临时邮箱仅在您主动使用录音或语音功能时使用麦克风。</string>

    <key>NSContactsUsageDescription</key>
    <string>临时邮箱仅在您主动选择联系人时访问通讯录。</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>临时邮箱仅在您主动启用语音输入时使用语音识别，将语音转换为文字。</string>
    <key>NSCalendarsUsageDescription</key>
    <string>临时邮箱仅在您主动管理日程时访问您选择的日历内容。</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>临时邮箱仅在您主动管理日程时读取或更新您选择的日历内容。</string>
    
    <!-- 定位权限（用户主动创建的地点专注规则） -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>临时邮箱仅在您主动使用位置相关功能时访问当前位置。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>临时邮箱仅在您主动启用位置相关功能后使用位置变化。</string>
</dict>
</plist>
